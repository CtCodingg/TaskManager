/* ==========================================================================
   TaskManager -- dark theme
   ==========================================================================
   Palette reference (kept in sync by hand with include/UiTheme.h):
     bg-base       #0d1117    bg-surface   #131822    bg-elevated  #1a2029
     border        #262c38    border-soft  #1e242e
     text-primary  #e7eaf0    text-secondary #939bb0  text-tertiary #5f6a80
     accent-brand  #38bdf8  (selection / focus / active tab)
     accent-cpu    #22d3ee    accent-memory #a78bfa
     accent-gpu    #fbbf24    accent-disk   #60a5fa
     accent-net-rx #34d399    accent-net-tx #fb923c
     good #34d399   warn #fbbf24   critical #f87171
   ========================================================================== */

* {
    outline: none;
}

QWidget {
    background-color: #0d1117;
    color: #e7eaf0;
    font-family: "Segoe UI", "Ubuntu", "Noto Sans", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0d1117;
}

QToolTip {
    background-color: #1a2029;
    color: #e7eaf0;
    border: 1px solid #262c38;
    padding: 4px 8px;
    border-radius: 4px;
}

/* --------------------------------------------------------------------- */
/* Tabs                                                                   */
/* --------------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #262c38;
    border-radius: 10px;
    background-color: #0d1117;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #939bb0;
    padding: 10px 22px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
    font-size: 13px;
}

QTabBar::tab:selected {
    color: #e7eaf0;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    color: #c3c9d6;
}

/* --------------------------------------------------------------------- */
/* Cards (QGroupBox) -- each metric card gets a colored left accent via   */
/* its objectName, set in MainWindow.cpp (#cpuCard, #memCard, ...)        */
/* --------------------------------------------------------------------- */
QGroupBox {
    background-color: #131822;
    border: 1px solid #262c38;
    border-radius: 10px;
    margin-top: 16px;
    padding: 16px 16px 12px 16px;
    font-weight: 700;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: 2px;
    padding: 0 6px;
    color: #939bb0;
}

#cpuCard  { border-left: 3px solid #22d3ee; }
#memCard  { border-left: 3px solid #a78bfa; }
#gpuCard  { border-left: 3px solid #fbbf24; }
#diskCard { border-left: 3px solid #60a5fa; }

/* --------------------------------------------------------------------- */
/* Labels                                                                 */
/* --------------------------------------------------------------------- */
QLabel {
    background: transparent;
    color: #d7dce6;
}

QLabel#metricValue {
    font-family: "Consolas", "Cascadia Mono", "DejaVu Sans Mono", monospace;
    font-size: 24px;
    font-weight: 700;
    color: #e7eaf0;
}

QLabel#metricSubtle {
    color: #5f6a80;
    font-size: 12px;
}

QLabel#sectionHint {
    color: #5f6a80;
    font-size: 11px;
}

/* --------------------------------------------------------------------- */
/* Line edit (process filter box)                                        */
/* --------------------------------------------------------------------- */
QLineEdit {
    background-color: #1a2029;
    border: 1px solid #262c38;
    border-radius: 8px;
    padding: 8px 12px;
    color: #e7eaf0;
    selection-background-color: #38bdf8;
    selection-color: #0b0f14;
}

QLineEdit:focus {
    border: 1px solid #38bdf8;
}

QLineEdit::placeholder {
    color: #5f6a80;
}

/* --------------------------------------------------------------------- */
/* Buttons                                                                */
/* --------------------------------------------------------------------- */
QPushButton {
    background-color: #1a2029;
    color: #e7eaf0;
    border: 1px solid #262c38;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #212836;
    border-color: #38bdf8;
}

QPushButton:pressed {
    background-color: #161c26;
}

QPushButton#endTaskButton:hover {
    background-color: #2a1820;
    border-color: #f87171;
    color: #f87171;
}

/* --------------------------------------------------------------------- */
/* Progress bars -- color driven by the "level" dynamic property, set at  */
/* runtime in MainWindow.cpp via UiTheme::levelNameForPercent()           */
/* --------------------------------------------------------------------- */
QProgressBar {
    background-color: #1a2029;
    border: 1px solid #262c38;
    border-radius: 7px;
    text-align: center;
    color: #e7eaf0;
    height: 20px;
    font-size: 11px;
    font-weight: 600;
}

QProgressBar::chunk {
    border-radius: 6px;
}

QProgressBar[level="good"]::chunk     { background-color: #34d399; }
QProgressBar[level="warn"]::chunk     { background-color: #fbbf24; }
QProgressBar[level="critical"]::chunk { background-color: #f87171; }

/* --------------------------------------------------------------------- */
/* Tables                                                                 */
/* --------------------------------------------------------------------- */
QTableView, QTableWidget {
    background-color: #131822;
    alternate-background-color: #161c26;
    gridline-color: #1e242e;
    border: 1px solid #262c38;
    border-radius: 8px;
    selection-background-color: #1c3f52;
    selection-color: #e7eaf0;
    color: #d7dce6;
}

QTableView::item, QTableWidget::item {
    padding: 5px 8px;
    border: none;
}

QHeaderView::section {
    background-color: #1a2029;
    color: #939bb0;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #262c38;
    border-right: 1px solid #1e242e;
    font-weight: 700;
    font-size: 11px;
}

QHeaderView::section:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #1a2029;
    border: none;
}

/* --------------------------------------------------------------------- */
/* Scroll areas / scroll bars                                            */
/* --------------------------------------------------------------------- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #262c38;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #333b4a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #262c38;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #333b4a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* --------------------------------------------------------------------- */
/* Menus (process table right-click menu)                                */
/* --------------------------------------------------------------------- */
QMenu {
    background-color: #1a2029;
    border: 1px solid #262c38;
    border-radius: 8px;
    padding: 4px;
    color: #e7eaf0;
}

QMenu::item {
    padding: 6px 22px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #38bdf8;
    color: #0b0f14;
}

QMenu::separator {
    height: 1px;
    background: #262c38;
    margin: 4px 6px;
}

/* --------------------------------------------------------------------- */
/* Status bar                                                             */
/* --------------------------------------------------------------------- */
QStatusBar {
    background-color: #0d1117;
    color: #5f6a80;
    border-top: 1px solid #262c38;
}

/* --------------------------------------------------------------------- */
/* Message boxes                                                          */
/* --------------------------------------------------------------------- */
QMessageBox {
    background-color: #131822;
}

/* --------------------------------------------------------------------- */
/* Chart view host (HistoryChartWidget draws its own dark chart theme in  */
/* C++; this just makes sure the surrounding QChartView frame matches)    */
/* --------------------------------------------------------------------- */
QGraphicsView {
    border: none;
    background: transparent;
}
